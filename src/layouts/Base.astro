---
import "../styles/global.css";
import { social, AFILIATE, CONTACTO } from "../data/social";
import Luto from "../components/Luto.astro";

interface Props {
  title: string;
  description?: string;
  fullBleed?: boolean;
}

const { title, description = "Sindicato de Inquilinas e Inquilinos de Cádiz. Organizadas contra el rentismo: mapa de viviendas turísticas, datos y herramientas para inquilinas.", fullBleed = false } = Astro.props;


const nav = [
  { href: "/", label: "Inicio" },
  { href: "/participa/", label: "Participa" },
  { href: "/agenda/", label: "Agenda" },
  { href: "/unete/", label: "Únete" },
  { href: CONTACTO, label: "Contacto" },
];
const tools = [
  { href: "/mapa/", label: "Mapa" },
  { href: "/fincas/", label: "Fincas" },
  { href: "/datos/", label: "Datos" },
  { href: "/utilidades/", label: "Utilidades" },
  { href: "/denuncia/", label: "Denunciar" },
];
const path = Astro.url.pathname;
const active = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const toolsActive = tools.some((t) => active(t.href));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Sindicato de Inquilinas de Cádiz</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <!-- Estadísticas del sindicato (Umami): sin cookies ni datos personales -->
    <script is:inline defer src="https://estadisticas.inquilinatocadiz.org/script.js" data-website-id="50041b1d-ef27-4a52-906e-1e4b53696c9a"></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <header id="site-header" class="relative z-[1100]">
      <div class="border-b-3 border-ink bg-white">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-4 md:gap-x-8">
          <div class="flex items-center gap-3">
            <a href="/" class="shrink-0" title="Sindicato de Inquilinas e Inquilinos de Cádiz">
              <img src="/logo-cabecera.png" alt="Sindicato de Inquilinas e Inquilinos de Cádiz" width="726" height="162" class="h-9 w-auto md:h-11" />
            </a>
            <Luto />
          </div>
          <div class="ml-auto flex items-center gap-5 md:hidden">
            <a href={AFILIATE} class="brut brut-hover display hidden bg-brand px-3 py-1 text-lg text-white [.js_&]:inline-block" data-umami-event="afiliate" data-umami-event-origen="cabecera">Afíliate</a>
            <button id="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" class="display hidden items-center gap-2 text-lg tracking-wide [.js_&]:flex">
              Menú <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
          </div>
          <nav id="site-nav" class="display relative flex w-full flex-col items-start gap-y-3 text-lg tracking-wide md:w-auto md:flex-row md:flex-wrap md:items-center md:gap-x-6">
            {nav.slice(0, 3).map((item) => (
              <a href={item.href} class:list={["border-b-3 pb-0.5 hover:text-brand", active(item.href) ? "border-ink" : "border-transparent"]}>{item.label}</a>
            ))}
            <details class="group md:relative">
              <summary class:list={["flex cursor-pointer list-none items-center gap-1 border-b-3 pb-0.5 hover:text-brand", toolsActive ? "border-ink" : "border-transparent"]}>
                Herramientas <i class="fa-solid fa-caret-down text-sm transition-transform group-open:rotate-180" aria-hidden="true"></i>
              </summary>
              <ul class="brut mt-2 bg-white py-1 md:absolute md:left-0 md:mt-3 md:min-w-44">
                {tools.map((t) => (
                  <li><a href={t.href} class:list={["block px-4 py-2 hover:bg-brand hover:text-white", { "bg-ink text-white": active(t.href) }]}>{t.label}</a></li>
                ))}
              </ul>
            </details>
            {nav.slice(3).map((item) => (
              <a href={item.href} class:list={["border-b-3 pb-0.5 hover:text-brand", active(item.href) ? "border-ink" : "border-transparent"]}>{item.label}</a>
            ))}
            <a href={AFILIATE} class="brut brut-hover bg-brand px-3 py-1 text-white max-md:[.js_&]:hidden" data-umami-event="afiliate" data-umami-event-origen="cabecera">Afíliate</a>
          </nav>
        </div>
      </div>
    </header>

    <main class:list={["flex-1", { "mx-auto w-full max-w-6xl px-4 py-8": !fullBleed }]}>
      <slot />
    </main>

    <footer class="border-t-3 border-ink bg-ink text-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-4 py-6">
        <a href="/" class="display text-2xl italic leading-none" title="Sindicato de Inquilinas e Inquilinos de Cádiz">SIC</a>
        <nav class="display flex flex-wrap items-center gap-x-6 gap-y-1 text-sm italic tracking-wide">
          <a href={CONTACTO} class="hover:text-brand">Contacto</a>
          <a href="/participa/" class="hover:text-brand">Participa</a>
          <a href="/aviso-legal-y-privacidad/" class="hover:text-brand">Aviso legal y privacidad</a>
          <a href="/agenda/" class="hover:text-brand">Agenda</a>
          <a href="/unete/" class="hover:text-brand">Únete</a>
          <a href="/datos/" class="hover:text-brand">Datos</a>
        </nav>
        <div class="flex gap-4 text-2xl">
          {social.map((s) => (
            <a href={s.href} aria-label={s.label} title={s.label} rel="noopener" target="_blank" class="hover:text-brand"><i class={s.icon} aria-hidden="true"></i></a>
          ))}
        </div>
      </div>
    </footer>
    <script is:inline>
      document.getElementById("menu-toggle").addEventListener("click", (e) => {
        const open = document.getElementById("site-nav").classList.toggle("is-open");
        e.currentTarget.setAttribute("aria-expanded", String(open));
      });
    </script>
  </body>
</html>
