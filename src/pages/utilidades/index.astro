---
import Base from "../../layouts/Base.astro";

const tools = [
  { href: "/utilidades/renta/", title: "¿Me pueden subir tanto el alquiler?", text: "Calcula la subida máxima legal según tu contrato y el índice que toca (IRAV o IPC), y qué contestar." },
  { href: "/utilidades/plazos/", title: "¿Hasta cuándo puedo quedarme?", text: "Prórroga obligatoria, prórroga tácita, preavisos y fechas clave de tu contrato." },
  { href: "/utilidades/contrato/", title: "¿Tiene trampas mi contrato?", text: "Repasa las cláusulas nulas o abusivas más habituales y qué dice la ley de cada una." },
  { href: "/utilidades/precio-referencia/", title: "¿Cuánto se paga por aquí?", text: "Cómo consultar el precio de referencia oficial de tu zona y para qué sirve en Cádiz." },
  { href: "/mapa/", title: "¿Hay licencia turística en mi edificio?", text: "Busca tu calle en el mapa de viviendas turísticas registradas." },
];
---

<Base image="/og/utilidades.png" title="Utilidades para inquilinas">
  <h1 class="display text-6xl md:text-7xl">Utilidades</h1>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed md:text-xl">Cinco preguntas que nos hacen cada semana en la asamblea, con respuesta rápida. Gratis, sin registro y sin guardar nada de lo que escribes: todo se calcula en tu navegador.</p>

  <ul class="mt-12 grid gap-8 sm:grid-cols-2">
    {tools.map((t) => (
      <li>
        <a href={t.href} class="brut brut-hover group flex h-full flex-col bg-white p-7">
          <h2 class="display text-3xl group-hover:text-brand">{t.title}</h2>
          <p class="mt-3 leading-relaxed">{t.text}</p>
          <span class="display mt-auto pt-5 text-lg text-brand">Abrir →</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
