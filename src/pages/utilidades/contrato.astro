---
import Base from "../../layouts/Base.astro";
import Aviso from "../../components/Aviso.astro";

// Las explicaciones dependen de la fecha de firma (régimen legal) y del tipo de arrendador: están en contrato.ts.
const checks = [
  { id: "duration", q: "Dura un año o menos de lo que marca la ley como prórroga obligatoria" },
  { id: "waiver", q: "Renuncias a la prórroga o aceptas irte cuando te lo pidan" },
  { id: "deposit", q: "Fianza de más de un mes, o garantías adicionales muy altas" },
  { id: "agency", q: "Te cobran los honorarios de la agencia o la gestión del contrato" },
  { id: "update", q: "La renta se actualiza «libremente», «según mercado» o sin decir con qué índice" },
  { id: "seasonal", q: "Es un contrato «de temporada» pero es tu vivienda habitual" },
  { id: "census", q: "Te prohíben empadronarte" },
  { id: "penalty", q: "Penalización por irte antes superior a un mes de renta por año que falte" },
  { id: "repairs", q: "Las reparaciones y obras de conservación corren de tu cuenta" },
  { id: "expenses", q: "Pagas IBI, comunidad u otros gastos sin que el contrato diga el importe anual" },
  { id: "entry", q: "El propietario puede entrar cuando quiera o hacer visitas sin avisar" },
  { id: "sale", q: "Si venden el piso tienes que irte" },
];
const field = "mt-1 block w-full border-3 border-ink bg-white px-3 py-2 focus:outline-3 focus:outline-offset-2 focus:outline-brand";
---

<Base image="/og/utilidades.png" title="Comprobador de contrato de alquiler">
  <div class="max-w-2xl">
    <p class="font-mono text-xs uppercase tracking-widest text-neutral-600"><a href="/utilidades/" class="underline underline-offset-2 hover:text-brand">Utilidades</a> / Comprobador</p>
    <h1 class="display mt-2 text-5xl md:text-6xl">¿Tiene trampas mi contrato?</h1>
    <p class="mt-4 text-lg leading-relaxed">Lo que vale y lo que no depende de cuándo firmaste y de quién es el arrendador. Marca lo que aparezca en tu contrato y te decimos qué es nulo, qué es abusivo y con qué artículo defenderte.</p>

    <form id="contrato" class="brut mt-6 bg-white" onsubmit="return false">
      <div class="grid gap-4 border-b-3 border-ink p-6 sm:grid-cols-2">
        <label class="block"><span class="text-sm font-semibold">Fecha de firma del contrato</span><input id="signed" type="date" required class={field} /></label>
        <label class="block"><span class="text-sm font-semibold">¿Quién es el arrendador?</span>
          <select id="landlord" class={field}>
            <option value="natural">Una persona (particular)</option>
            <option value="legal">Una empresa, fondo, sociedad o entidad</option>
          </select>
        </label>
        <p id="regime" class="text-sm text-neutral-600 sm:col-span-2"></p>
      </div>
      <div class="divide-y-2 divide-ink/10">
        {checks.map((c) => (
          <label class="flex cursor-pointer items-start gap-3 px-6 py-3 hover:bg-paper">
            <input type="checkbox" name="check" value={c.id} class="mt-1 size-4 shrink-0 accent-brand" />
            <span>{c.q}</span>
          </label>
        ))}
      </div>
      <div class="border-t-3 border-ink px-6 py-5">
        <button type="submit" class="brut brut-hover display bg-brand px-8 py-3 text-2xl text-white">Ver resultado</button>
      </div>
    </form>

    <section id="result" class="mt-6 hidden"></section>

    <Aviso />
  </div>
</Base>

<script src="../../scripts/contrato.ts"></script>
