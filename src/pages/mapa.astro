---
import Base from "../layouts/Base.astro";
import municipios from "../data/municipios.json";

const DEFAULT = "cadiz";
const inicial = municipios.municipios.find((m) => m.slug === DEFAULT) ?? municipios.municipios[0];
const fmt = (n: number) => n.toLocaleString("es-ES");
---

<Base image="/og/piso-turistico.png" title="Mapa de viviendas turísticas de la provincia de Cádiz" fullBleed>
  <div class="grid min-h-[560px] grid-rows-[auto_1fr] lg:h-[calc(100vh-79px)] lg:grid-cols-[360px_1fr] lg:grid-rows-1">
    <aside class="overflow-y-auto border-b-3 border-ink bg-white p-4 lg:border-b-0 lg:border-r-3">
      <h1 class="display text-3xl">Viviendas turísticas en <span id="muni-name">{inicial.name}</span></h1>
      <p class="mt-2 text-sm text-neutral-600">
        <strong id="muni-stats">{fmt(inicial.total)} alojamientos turísticos registrados y {fmt(inicial.places)} plazas</strong>.
        Datos oficiales de la Junta para los {municipios.municipios.length} municipios de la provincia, actualizados el {municipios.source_updated_at}.
      </p>

      <form id="filters" class="mt-4 space-y-3 text-sm" onsubmit="return false">
        <label class="block">
          <span class="font-medium">Municipio</span>
          <select id="muni" class="mt-1 w-full border-3 border-ink bg-white px-2 py-2 focus:outline-3 focus:outline-offset-2 focus:outline-brand">
            {municipios.municipios.map((m) => <option value={m.slug} selected={m.slug === inicial.slug}>{`${m.name} (${fmt(m.total)})`}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="font-medium">¿Hay licencia turística en tu calle?</span>
          <input id="q" type="search" placeholder="Escribe la calle: Sopranis, Plocia…" autocomplete="off"
            class="mt-1 w-full border-3 border-ink bg-white px-3 py-2 focus:outline-3 focus:outline-offset-2 focus:outline-brand" />
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="text-xs text-neutral-600">Tipo</span>
            <select id="group" class="mt-1 w-full border-3 border-ink bg-white px-2 py-2 focus:outline-3 focus:outline-offset-2 focus:outline-brand">
              <option value="">Todos</option>
              <option value="Completa">Vivienda completa</option>
              <option value="Por habitaciones">Por habitaciones</option>
            </select>
          </label>
          <label class="block"><span class="text-xs text-neutral-600">Código postal</span>
            <select id="cp" class="mt-1 w-full border-3 border-ink bg-white px-2 py-2 focus:outline-3 focus:outline-offset-2 focus:outline-brand">
              <option value="">Todos</option>
            </select>
          </label>
        </div>
        <label class="flex items-center gap-2"><input id="companies" type="checkbox" class="size-4 accent-brand" /> Sólo las que son de empresas</label>
        <p id="count" class="text-neutral-600" aria-live="polite">Cargando…</p>
      </form>

      <div class="mt-4 border-l-8 border-brand bg-paper p-3 text-xs text-neutral-700">
        <p class="font-medium text-neutral-800">Cómo leerlo</p>
        <ul class="mt-1 list-disc space-y-1 pl-4">
          <li>Cada punto es un alojamiento inscrito en el Registro de Turismo de Andalucía (VUT o apartamento turístico).</li>
          <li>Los titulares que son personas físicas aparecen como «particular»: la Junta no publica su nombre y nosotras tampoco.</li>
          <li>Si tu piso o tu edificio aparece y no lo sabías, o el piso donde vives se anuncia sin estar aquí, <a href="/denuncia/" class="underline">cuéntanoslo</a>.</li>
        </ul>
        <p class="mt-2">Fuente: <a href="https://www.juntadeandalucia.es/datosabiertos/portal/dataset/openrta" rel="noopener" class="underline">OpenRTA, Registro de Turismo de Andalucía</a> (CC BY 4.0), actualizado el {municipios.source_updated_at}. Mapa base de OpenStreetMap.</p>
      </div>

      <ul id="results" class="mt-4 hidden divide-y-2 divide-ink/10 border-3 border-ink text-sm"></ul>
    </aside>

    <div id="map" class="order-first min-h-[60vh] bg-neutral-100 lg:order-none lg:min-h-0" role="region" aria-label="Mapa de viviendas turísticas"></div>
  </div>
</Base>

<script src="../scripts/map.ts"></script>
